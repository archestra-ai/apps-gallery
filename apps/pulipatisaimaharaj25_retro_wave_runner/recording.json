{"formatVersion":1,"app":{"id":"1203c778-00dd-4f31-aa53-546495baf7bf","name":"Retro Wave Runner"},"recording":{"title":"Retro Wave Runner demo — 2026-07-28 14:55","startedAt":"2026-07-28T14:55:17.404Z","durationMs":143863,"events":[{"kind":"mcp","t":105785,"method":"resources/read","params":{"uri":"ui://archestra-app/1203c778-00dd-4f31-aa53-546495baf7bf"},"result":{"contents":[{"uri":"ui://archestra-app/1203c778-00dd-4f31-aa53-546495baf7bf","mimeType":"text/html;profile=mcp-app","text":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline' http://localhost:3000/_sandbox/ext-apps-app.js http://localhost:3000/_sandbox/archestra-app-sdk.js data: blob: cdn.jsdelivr.net unpkg.com cdnjs.cloudflare.com fonts.googleapis.com fonts.gstatic.com; style-src 'unsafe-inline' http://localhost:3000/_sandbox/archestra-app-base.css data: blob: cdn.jsdelivr.net unpkg.com cdnjs.cloudflare.com fonts.googleapis.com fonts.gstatic.com; img-src data: blob: cdn.jsdelivr.net unpkg.com cdnjs.cloudflare.com fonts.googleapis.com fonts.gstatic.com; font-src data: blob: cdn.jsdelivr.net unpkg.com cdnjs.cloudflare.com fonts.googleapis.com fonts.gstatic.com; media-src data: blob: cdn.jsdelivr.net unpkg.com cdnjs.cloudflare.com fonts.googleapis.com fonts.gstatic.com; connect-src 'none'; form-action 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'\"><link rel=\"stylesheet\" href=\"http://localhost:3000/_sandbox/archestra-app-base.css\" data-archestra-app-base-css><script data-archestra-app-bootstrap>window.__ARCHESTRA_APP_CONTEXT__={\"user\":{\"id\":\"xOruLdynyEevpNlU6VXSLNX7H0HVVeCB\",\"name\":\"Admin\"},\"tools\":[],\"appId\":\"1203c778-00dd-4f31-aa53-546495baf7bf\",\"version\":2,\"captureScreenshot\":true,\"sdkUrl\":\"http://localhost:3000/_sandbox/ext-apps-app.js\"};</script><script data-archestra-app-sdk src=\"http://localhost:3000/_sandbox/archestra-app-sdk.js\"></script>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Retro Wave Runner</title>\n  <style>\n    :root {\n      --neon-cyan: #0ff;\n      --neon-magenta: #f0f;\n      --laser-violet: #80f;\n      --bg-dark: #05050a;\n    }\n    body {\n      background: var(--bg-dark);\n      color: var(--neon-cyan);\n      font-family: 'Courier New', Courier, monospace;\n      margin: 0;\n      padding: 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      min-height: 100vh;\n      overflow-x: hidden;\n    }\n    #visualizer {\n      width: 100%;\n      max-width: 800px;\n      height: 200px;\n      border: 2px solid var(--neon-magenta);\n      border-radius: 10px;\n      background: #111;\n      margin-bottom: 20px;\n      box-shadow: 0 0 15px var(--neon-magenta);\n    }\n    .grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 15px;\n      width: 100%;\n      max-width: 600px;\n    }\n    .pad {\n      height: 80px;\n      border: 2px solid var(--neon-cyan);\n      border-radius: 8px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      font-weight: bold;\n      transition: all 0.1s;\n      box-shadow: 0 0 5px var(--neon-cyan);\n    }\n    .pad:active, .pad.active {\n      background: var(--neon-cyan);\n      color: black;\n      transform: scale(0.95);\n      box-shadow: 0 0 20px var(--neon-cyan);\n    }\n    .controls {\n      margin-top: 20px;\n      display: flex;\n      gap: 20px;\n      color: white;\n    }\n  </style>\n</head>\n<body>\n  <h1>RETRO WAVE RUNNER</h1>\n  <canvas id=\"visualizer\"></canvas>\n  <div class=\"grid\" id=\"padGrid\"></div>\n  <div class=\"controls\">\n    <label>BPM: <input type=\"range\" id=\"bpm\" min=\"60\" max=\"180\" value=\"120\"></label>\n    <label><input type=\"checkbox\" id=\"gameMode\"> Game Mode</label>\n  </div>\n\n  <script>\n    const padNames = ['Drum 1', 'Drum 2', 'Lead', 'Bass', 'Chime 1', 'Chime 2', 'Laser', 'Wave'];\n    const grid = document.getElementById('padGrid');\n    padNames.forEach(name => {\n      const pad = document.createElement('div');\n      pad.className = 'pad';\n      pad.innerText = name;\n      pad.onclick = () => triggerPad(pad);\n      grid.appendChild(pad);\n    });\n\n    function triggerPad(el) {\n      el.classList.add('active');\n      setTimeout(() => el.classList.remove('active'), 150);\n    }\n\n    const canvas = document.getElementById('visualizer');\n    const ctx = canvas.getContext('2d');\n    function draw() {\n      ctx.fillStyle = '#05050a';\n      ctx.fillRect(0, 0, canvas.width, canvas.height);\n      ctx.strokeStyle = '#0ff';\n      ctx.beginPath();\n      for(let i=0; i<canvas.width; i++) {\n        ctx.lineTo(i, 100 + Math.sin(i * 0.05 + Date.now() * 0.005) * 50);\n      }\n      ctx.stroke();\n      requestAnimationFrame(draw);\n    }\n    draw();\n  </script>\n</body>\n</html>","_meta":{"ui":{"csp":{"resourceDomains":["cdn.jsdelivr.net","unpkg.com","cdnjs.cloudflare.com","fonts.googleapis.com","fonts.gstatic.com"]}}}}]},"durationMs":444},{"kind":"mcp","t":105877,"method":"resources/read","params":{"uri":"ui://archestra-app/1203c778-00dd-4f31-aa53-546495baf7bf"},"result":{"contents":[{"uri":"ui://archestra-app/1203c778-00dd-4f31-aa53-546495baf7bf","mimeType":"text/html;profile=mcp-app","text":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline' http://localhost:3000/_sandbox/ext-apps-app.js http://localhost:3000/_sandbox/archestra-app-sdk.js data: blob: cdn.jsdelivr.net unpkg.com cdnjs.cloudflare.com fonts.googleapis.com fonts.gstatic.com; style-src 'unsafe-inline' http://localhost:3000/_sandbox/archestra-app-base.css data: blob: cdn.jsdelivr.net unpkg.com cdnjs.cloudflare.com fonts.googleapis.com fonts.gstatic.com; img-src data: blob: cdn.jsdelivr.net unpkg.com cdnjs.cloudflare.com fon